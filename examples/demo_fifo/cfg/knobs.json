{
  "_comment": [
    "USER SPACE: the plusargs this demo testbench understands.",
    "AId-UVO-RT treats them as opaque knobs and generates profiles from them.",
    "The framework itself never contains these names."
  ],
  "knobs": [
    {
      "name": "NUM_TXNS",
      "kind": "plusarg_int",
      "lo": 100,
      "hi": 2000,
      "step": 100,
      "description": "number of randomised transactions per run"
    },
    {
      "name": "STIM_MODE",
      "kind": "plusarg_enum",
      "values": ["0", "1", "2"],
      "description": "0 uniform, 1 corner-heavy, 2 back-to-back"
    },
    {
      "name": "RD_RATIO",
      "kind": "plusarg_int",
      "lo": 10,
      "hi": 90,
      "step": 10,
      "description": "percentage of cycles that drive a read"
    },
    {
      "name": "ERR_RATE",
      "kind": "plusarg_enum",
      "values": ["0", "5", "20"],
      "description": "percentage of illegal stimulus (overflow/underflow corners)"
    }
  ],
  "profiles": [
    { "name": "none",         "values": {},                                                    "description": "no overrides (control)" },
    { "name": "conservative", "values": {"NUM_TXNS": "200",  "STIM_MODE": "0", "RD_RATIO": "50", "ERR_RATE": "0"},  "description": "plain random" },
    { "name": "balanced",     "values": {"NUM_TXNS": "800",  "STIM_MODE": "0", "RD_RATIO": "70", "ERR_RATE": "5"},  "description": "read-heavy" },
    { "name": "aggressive",   "values": {"NUM_TXNS": "2000", "STIM_MODE": "2", "RD_RATIO": "50", "ERR_RATE": "20"}, "description": "long back-to-back with illegal stimulus" },
    { "name": "corner_heavy", "values": {"NUM_TXNS": "1200", "STIM_MODE": "1", "RD_RATIO": "30", "ERR_RATE": "20"}, "description": "corner data values + overflow/underflow" }
  ]
}
