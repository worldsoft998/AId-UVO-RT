{
  "mode": "blackbox",
  "ai": true,
  "algorithm": "linucb",
  "seed": 1,
  "outdir": "runs",
  "name": "fifo_blackbox",
  "budget": { "max_runs": 12, "target_closure": 0.95, "min_runs": 1 },
  "knobs": {
    "knobs": [
      { "name": "NUM_TXNS",  "kind": "plusarg_int",  "lo": 100, "hi": 2000, "step": 100 },
      { "name": "STIM_MODE", "kind": "plusarg_enum", "values": ["0", "1", "2"] },
      { "name": "RD_RATIO",  "kind": "plusarg_int",  "lo": 10,  "hi": 90,   "step": 10 },
      { "name": "ERR_RATE",  "kind": "plusarg_enum", "values": ["0", "5", "20"] }
    ],
    "profiles": [
      { "name": "none",         "values": {} },
      { "name": "balanced",     "values": {"NUM_TXNS": "800",  "STIM_MODE": "0", "RD_RATIO": "70", "ERR_RATE": "5"} },
      { "name": "aggressive",   "values": {"NUM_TXNS": "2000", "STIM_MODE": "2", "RD_RATIO": "50", "ERR_RATE": "20"} },
      { "name": "corner_heavy", "values": {"NUM_TXNS": "1200", "STIM_MODE": "1", "RD_RATIO": "30", "ERR_RATE": "20"} }
    ]
  },
  "blackbox": {
    "kind": "questa",
    "run_time": "2000us",
    "period_ns": 10.0,
    "timeout_s": 1800,
    "abort_on_error": true,
    "abort_on_assert": false,
    "stall_seconds": 0,
    "tests": ["tb_top_opt"],
    "launch": { "exe": "vsim", "lib": "work", "top": "tb_top_opt", "coverage": true }
  },
  "notes": "blackbox campaign: seeds + plusarg profiles + run length only"
}
