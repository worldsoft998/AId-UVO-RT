{
  "mode": "runtime",
  "ai": true,
  "algorithm": "linucb",
  "inner_algorithm": "ppo",
  "seed": 1,
  "outdir": "runs",
  "name": "fifo_runtime",
  "focus_limit": 8,
  "budget": {
    "max_runs": 6,
    "target_closure": 0.95,
    "max_steps_per_run": 8,
    "min_runs": 1,
    "plateau_runs": 0
  },
  "reward": {},
  "knobs": {
    "knobs": [
      { "name": "NUM_TXNS",  "kind": "plusarg_int",  "lo": 100, "hi": 2000, "step": 100 },
      { "name": "STIM_MODE", "kind": "plusarg_enum", "values": ["0", "1", "2"] },
      { "name": "RD_RATIO",  "kind": "plusarg_int",  "lo": 10,  "hi": 90,   "step": 10 },
      { "name": "ERR_RATE",  "kind": "plusarg_enum", "values": ["0", "5", "20"] }
    ],
    "profiles": [
      { "name": "none",         "values": {} },
      { "name": "balanced",     "values": {"NUM_TXNS": "800",  "STIM_MODE": "0", "RD_RATIO": "70", "ERR_RATE": "5"} },
      { "name": "aggressive",   "values": {"NUM_TXNS": "2000", "STIM_MODE": "2", "RD_RATIO": "50", "ERR_RATE": "20"} },
      { "name": "corner_heavy", "values": {"NUM_TXNS": "1200", "STIM_MODE": "1", "RD_RATIO": "30", "ERR_RATE": "20"} }
    ]
  },
  "srie": {
    "transport": { "kind": "pipe" },
    "discover_root": "/",
    "discover_depth": 3,
    "coverage_cmd": "coverage report -detail -xml -output {output}",
    "coverage_format": "auto",
    "max_forced": 4,
    "allow_outputs": false,
    "value_base": "dec",
    "quantum_cycles": 200,
    "period_ns": 10.0,
    "intra_steps": 8,
    "probe": true,
    "launch": {
      "exe": "vsim",
      "lib": "work",
      "top": "tb_top_opt",
      "coverage": true,
      "plusargs": {}
    }
  },
  "blackbox": {
    "kind": "questa",
    "run_time": "2000us",
    "period_ns": 10.0,
    "abort_on_error": true
  },
  "notes": "runtime (SRIE) campaign for the demo FIFO; root '/' means discovery finds everything"
}
