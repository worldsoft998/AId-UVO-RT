%% AId-UVO-RT layered architecture (Mermaid source for docs/01-architecture.md)
flowchart TB
    subgraph entry [Entry points]
        W[".bat / .sh menus"]
        C["python -m aiduvo"]
    end

    subgraph engine [Campaign engine - aiduvo/core]
        E["Campaign: budget, reward,\nstate encoder, action space, policy"]
        S[("history.sqlite")]
    end

    subgraph backends [Backends]
        RB["RuntimeBackend\n(SRIE)"]
        BB["BlackboxBackend\n(vsim + UCDB)"]
        MB["MockBlackboxBackend\n(synthetic)"]
    end

    subgraph srie [SRIE - aiduvo/srie]
        T["transport\npipe | socket | FLI | mock"]
        I["introspection\ndescribe / examine / coverage"]
        R["reflection\nforce / release / when / run"]
    end

    subgraph services [Shared services]
        CV["coverage\nUCIS / CSV / text"]
        RL["rl\nbandits / Q / DQN / PPO / ANN"]
        RP["reporting\ncompare / SVG / HTML"]
        LINT["lint\nnon-intrusiveness"]
    end

    subgraph sim [Simulator]
        VS["QuestaSim vsim"]
        UDB[("UCDB")]
        LOG[("transcript")]
    end

    W --> engine
    C --> engine
    engine --> RB
    engine --> BB
    engine --> MB
    RB --> T
    T --> I
    T --> R
    I --> VS
    R --> VS
    BB --> VS
    VS --> UDB
    VS --> LOG
    UDB --> CV
    LOG --> CV
    CV --> engine
    engine --> S
    RL --> engine
    engine --> RP
    LINT -.checks.-> engine
